# Copia este archivo como `key.properties` (sin .template) y rellena los valores.
# `key.properties` está en .gitignore — NUNCA lo commitees.
#
# Para generar el keystore:
#   keytool -genkey -v -keystore ~/keystores/parking-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias parking
#
# Después rellena los campos de abajo:

storePassword=TU_PASSWORD_DEL_KEYSTORE
keyPassword=TU_PASSWORD_DEL_ALIAS
keyAlias=parking
storeFile=/Users/alexargueta/keystores/parking-release.jks
