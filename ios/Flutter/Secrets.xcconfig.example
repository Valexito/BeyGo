// Copia este archivo como Secrets.xcconfig (está fuera de git) y pon tu clave
// de Google Maps para iOS, restringida a los bundle IDs com.beygo.app y com.beygo.app.dev.
MAPS_API_KEY_IOS = tu_clave_de_maps_para_ios

// Facebook Login (app de Meta de desarrollo). El App Secret NO va aquí:
// solo se pega en Firebase → Authentication → Facebook.
FACEBOOK_APP_ID_DEV = tu_app_id_de_facebook
FACEBOOK_CLIENT_TOKEN_DEV = tu_client_token_de_facebook
