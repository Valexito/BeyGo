rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*');
    }

    // Dueño de la solicitud de proveedor según Firestore (provider_requests/{id}.uid).
    // Las fotos se suben ANTES de crear el documento de la solicitud, por eso
    // mientras el documento no exista se permite al usuario autenticado (el id
    // es un identificador aleatorio no adivinable). Una vez creado, solo el
    // dueño de la solicitud o un admin pueden leer/modificar/borrar.
    function requestDocPath(requestId) {
      return /databases/(default)/documents/provider_requests/$(requestId);
    }

    function requestNotCreatedYet(requestId) {
      return !firestore.exists(requestDocPath(requestId));
    }

    function isRequestOwner(requestId) {
      return signedIn()
        && firestore.exists(requestDocPath(requestId))
        && firestore.get(requestDocPath(requestId)).data.uid == request.auth.uid;
    }

    // Dueño del parqueo según Firestore (parkings/{id}.ownerID).
    function isParkingOwnerOf(pid) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/parkings/$(pid))
        && firestore.get(/databases/(default)/documents/parkings/$(pid)).data.ownerID == request.auth.uid;
    }

    function under10MB() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /users/{uid}/{rest=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if (isOwner(uid) || isAdmin()) && isImage() && under10MB();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Documentos sensibles (DPI, patente, fotos): solo dueño de la solicitud o admin.
    match /provider_requests/{requestId}/{rest=**} {
      allow read: if isAdmin()
        || (signedIn() && (requestNotCreatedYet(requestId) || isRequestOwner(requestId)));

      allow create, update: if signedIn()
        && isImage() && under10MB()
        && (isAdmin() || requestNotCreatedYet(requestId) || isRequestOwner(requestId));

      allow delete: if isAdmin() || isRequestOwner(requestId);
    }

    match /support_reports/{uid}/{reportId}/{rest=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if (isOwner(uid) || isAdmin()) && isImage() && under10MB();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /parkings/{pid}/{rest=**} {
      allow read: if true;
      allow create, update: if signedIn() && isImage() && under10MB()
        && (isAdmin() || isParkingOwnerOf(pid));
      allow delete: if isAdmin();
    }

    match /{all=**} {
      allow read, write: if false;
    }
  }
}
