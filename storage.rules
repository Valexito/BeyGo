rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*');
    }

    function under10MB() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /users/{uid}/{rest=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if (isOwner(uid) || isAdmin()) && isImage() && under10MB();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /provider_requests/{requestId}/{rest=**} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.resource != null
        && request.resource.size < 10 * 1024 * 1024;

      allow delete: if signedIn();
    }

    match /support_reports/{uid}/{reportId}/{rest=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if (isOwner(uid) || isAdmin()) && isImage() && under10MB();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /parkings/{pid}/{rest=**} {
      allow read: if true;
      allow create, update: if signedIn() && isImage() && under10MB();
      allow delete: if isAdmin();
    }

    match /{all=**} {
      allow read, write: if false;
    }
  }
}
