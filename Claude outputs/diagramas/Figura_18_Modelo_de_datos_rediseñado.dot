digraph ER { graph [rankdir=TB, nodesep=0.35, ranksep=0.8, fontname="Liberation Sans", labelloc=t, label=<<FONT POINT-SIZE="24"><B>Modelo de datos – Colecciones de Firestore (BeyGo)</B></FONT><BR/><FONT POINT-SIZE="18"><I>Relaciones lógicas (NoSQL): cada documento guarda el identificador del documento relacionado</I></FONT><BR/> >];
node [shape=plaintext, fontname="Liberation Sans", fontsize=19]; edge [fontname="Liberation Sans", fontsize=18, penwidth=1.6, arrowhead=none];
usuarios [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e9c" STYLE="ROUNDED"><TR><TD COLSPAN="2" BGCOLOR="#1f4e9c"><FONT COLOR="white" POINT-SIZE="21"><B>usuarios</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>uid</B> <FONT COLOR="#333333">PK</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">correo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">rol <FONT COLOR="#333333">usuario/proveedor/admin</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">fcmToken</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">createdAt</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>timestamp</I></FONT></TD></TR></TABLE>>];
solicitudes [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6a3d9a" STYLE="ROUNDED"><TR><TD COLSPAN="2" BGCOLOR="#6a3d9a"><FONT COLOR="white" POINT-SIZE="21"><B>solicitudes_proveedor<BR/>(provider_requests)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>solicitudId</B> <FONT COLOR="#333333">PK</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>usuarioId</B> <FONT COLOR="#333333">FK usuarios</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">nombreParqueo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">direccion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">ubicacion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>geopoint</I></FONT></TD></TR><TR><TD ALIGN="LEFT">capacidad</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>number</I></FONT></TD></TR><TR><TD ALIGN="LEFT">precioPorHora</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>number</I></FONT></TD></TR><TR><TD ALIGN="LEFT">estado <FONT COLOR="#333333">pendiente/aprobada/rechazada</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">revisadoPor <FONT COLOR="#333333">admin</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">fechaRevision</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>timestamp</I></FONT></TD></TR></TABLE>>];
parqueos [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1d7a3a" STYLE="ROUNDED"><TR><TD COLSPAN="2" BGCOLOR="#1d7a3a"><FONT COLOR="white" POINT-SIZE="21"><B>parqueos</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>parqueoId</B> <FONT COLOR="#333333">PK</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>proveedorId</B> <FONT COLOR="#333333">FK usuarios</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>solicitudId</B> <FONT COLOR="#333333">FK solicitudes_proveedor</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">ubicacion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>geopoint</I></FONT></TD></TR><TR><TD ALIGN="LEFT">espaciosTotales</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>number</I></FONT></TD></TR><TR><TD ALIGN="LEFT">espaciosDisponibles</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>number</I></FONT></TD></TR></TABLE>>];
reservas [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#b5530e" STYLE="ROUNDED"><TR><TD COLSPAN="2" BGCOLOR="#b5530e"><FONT COLOR="white" POINT-SIZE="21"><B>reservas</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>reservaId</B> <FONT COLOR="#333333">PK</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>usuarioId</B> <FONT COLOR="#333333">FK usuarios</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>parqueoId</B> <FONT COLOR="#333333">FK parqueos</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">estado <FONT COLOR="#333333">pendiente/activa/...</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">fechaInicio</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>timestamp</I></FONT></TD></TR><TR><TD ALIGN="LEFT">fechaFin</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>timestamp</I></FONT></TD></TR><TR><TD ALIGN="LEFT">montoTotal</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>number</I></FONT></TD></TR></TABLE>>];
calificaciones [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e9c" STYLE="ROUNDED"><TR><TD COLSPAN="2" BGCOLOR="#1f4e9c"><FONT COLOR="white" POINT-SIZE="21"><B>calificaciones</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>calificacionId</B> <FONT COLOR="#333333">PK</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>reservaId</B> <FONT COLOR="#333333">FK reservas</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">puntuacion <FONT COLOR="#333333">1 a 5</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>number</I></FONT></TD></TR><TR><TD ALIGN="LEFT">comentario</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR></TABLE>>];
mensajes [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1d7a3a" STYLE="ROUNDED"><TR><TD COLSPAN="2" BGCOLOR="#1d7a3a"><FONT COLOR="white" POINT-SIZE="21"><B>mensajes (chat)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>mensajeId</B> <FONT COLOR="#333333">PK</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>reservaId</B> <FONT COLOR="#333333">FK reservas</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>emisorId</B> <FONT COLOR="#333333">FK usuarios</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">texto</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>string</I></FONT></TD></TR><TR><TD ALIGN="LEFT">timestamp</TD><TD ALIGN="LEFT"><FONT COLOR="#555555"><I>timestamp</I></FONT></TD></TR></TABLE>>];
{rank=same; usuarios; solicitudes;}
{rank=same; parqueos; reservas;}
legend [shape=plaintext, label=<<FONT POINT-SIZE="14"><B>Leyenda:</B>  PK = identificador del documento   FK = referencia por identificador a otra colección   1:N = un documento se relaciona con varios   1:1 = uno con uno</FONT>>];
mensajes -> legend [style=invis];
usuarios -> solicitudes [color="#6a3d9a", fontcolor="#6a3d9a", label=<<B>1:N</B><BR/>envía>];
solicitudes -> parqueos [color="#6a3d9a", fontcolor="#6a3d9a", label=<<B>1:1</B><BR/>al aprobarse, crea>];
usuarios -> parqueos [color="#1d7a3a", fontcolor="#1d7a3a", label=<<B>1:N</B><BR/>administra (rol proveedor)>];
usuarios -> reservas [color="#1f4e9c", fontcolor="#1f4e9c", label=<<B>1:N</B><BR/>realiza>];
parqueos -> reservas [color="#1d7a3a", fontcolor="#1d7a3a", label=<<B>1:N</B><BR/>recibe>];
reservas -> calificaciones [color="#b5530e", fontcolor="#b5530e", label=<<B>1:1</B><BR/>se califica>];
reservas -> mensajes [color="#b5530e", fontcolor="#b5530e", label=<<B>1:N</B><BR/>chat>];
}