digraph ER { graph [rankdir=TB, nodesep=0.35, ranksep=0.75, fontname="Liberation Serif"]; node [shape=plaintext, fontname="Liberation Serif", fontsize=15]; edge [fontname="Liberation Serif", fontsize=14, color="#1f3b63", dir=both, arrowsize=1.1];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f3b63"><TR><TD COLSPAN="3" BGCOLOR="#1f3b63"><FONT COLOR="white"><B>users (usuarios)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>uid</B></TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">user | provider | admin</TD></TR><TR><TD ALIGN="LEFT">createdAt</TD><TD ALIGN="LEFT"><I>timestamp</I></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
vehicles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f3b63"><TR><TD COLSPAN="3" BGCOLOR="#1f3b63"><FONT COLOR="white"><B>vehicles (subcolección de users)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">plate</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">isPrimary</TD><TD ALIGN="LEFT"><I>boolean</I></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
provider_requests [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f3b63"><TR><TD COLSPAN="3" BGCOLOR="#1f3b63"><FONT COLOR="white"><B>provider_requests</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">uid</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">FK → users</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
favorites [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f3b63"><TR><TD COLSPAN="3" BGCOLOR="#1f3b63"><FONT COLOR="white"><B>favorites</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">userId</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">FK → users</TD></TR><TR><TD ALIGN="LEFT">parkingId</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">FK → parkings</TD></TR></TABLE>>];
parkings [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f3b63"><TR><TD COLSPAN="3" BGCOLOR="#1f3b63"><FONT COLOR="white"><B>parkings (parqueos)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">ownerID</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">FK → users (rol provider)</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">lat, lng</TD><TD ALIGN="LEFT"><I>number</I></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">pricePerHour</TD><TD ALIGN="LEFT"><I>number</I></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">capacity</TD><TD ALIGN="LEFT"><I>number</I></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">autoApproveReservations</TD><TD ALIGN="LEFT"><I>boolean</I></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">rating</TD><TD ALIGN="LEFT"><I>number</I></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
spaces [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f3b63"><TR><TD COLSPAN="3" BGCOLOR="#1f3b63"><FONT COLOR="white"><B>spaces (subcolección de parkings)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">PK, número de espacio</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">free | requested | occupied</TD></TR><TR><TD ALIGN="LEFT">currentReservationId</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">FK → reservations</TD></TR></TABLE>>];
