reviews [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f3b63"><TR><TD COLSPAN="3" BGCOLOR="#1f3b63"><FONT COLOR="white"><B>reviews (subcolección de parkings)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">uid</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">FK → users</TD></TR><TR><TD ALIGN="LEFT">reservationId</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">FK → reservations</TD></TR><TR><TD ALIGN="LEFT">rating</TD><TD ALIGN="LEFT"><I>number</I></TD><TD ALIGN="LEFT">1 a 5</TD></TR><TR><TD ALIGN="LEFT">comment</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
reservations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f3b63"><TR><TD COLSPAN="3" BGCOLOR="#1f3b63"><FONT COLOR="white"><B>reservations (reservas)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">userId</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">FK → users (conductor)</TD></TR><TR><TD ALIGN="LEFT">ownerId</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">FK → users (proveedor)</TD></TR><TR><TD ALIGN="LEFT">parkingId</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">FK → parkings</TD></TR><TR><TD ALIGN="LEFT">spaceNumber</TD><TD ALIGN="LEFT"><I>number</I></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">pending | active | completed | cancelled</TD></TR><TR><TD ALIGN="LEFT">providerApprovalStatus</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">pending | approved | rejected</TD></TR><TR><TD ALIGN="LEFT">reservedAt, endedAt</TD><TD ALIGN="LEFT"><I>timestamp</I></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT"><I>number</I></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
messages [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f3b63"><TR><TD COLSPAN="3" BGCOLOR="#1f3b63"><FONT COLOR="white"><B>messages (subcolección de reservations)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">senderId</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT">FK → users</TD></TR><TR><TD ALIGN="LEFT">senderRole</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"><I>string</I></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">createdAt</TD><TD ALIGN="LEFT"><I>timestamp</I></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
{rank=same; vehicles; provider_requests; favorites; parkings;}
{rank=same; spaces; walk_ins; reservations;}
{rank=same; messages; reviews;}
