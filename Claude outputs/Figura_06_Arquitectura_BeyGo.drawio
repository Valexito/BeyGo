<mxfile host="app.diagrams.net"><diagram name="Figura 6 - Arquitectura BeyGo" id="diag1"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#172a54;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1240" height="6" as="geometry"/></mxCell><mxCell id="v4" value="Arquitectura de la Aplicación BeyGo – Flutter ↔ Firebase ↔ Google Maps API" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontColor=#172a54;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="20" width="1240" height="30" as="geometry"/></mxCell><mxCell id="v5" value="Patrón de integración en tiempo real (Búsqueda y Reserva de Estacionamiento)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="0" y="52" width="1240" height="22" as="geometry"/></mxCell><mxCell id="v6" value="&lt;div style=&quot;font-family:Helvetica;text-align:left;padding:4px;&quot;&gt;&lt;div style=&quot;font-weight:bold;color:#1a3c8c;font-size:14px;&quot;&gt;📱 APLICACIÓN MÓVIL (Flutter)&lt;/div&gt;&lt;div style=&quot;color:#888888;font-size:10px;margin:2px 0 8px 0;&quot;&gt;Cliente · Android / iOS&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #cccccc;margin-bottom:10px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;&lt;b&gt;📍 Búsqueda de Parqueo&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#666666;font-size:10.5px;&quot;&gt;Mapa en tiempo real de espacios disponibles&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;&lt;b&gt;✅ Gestión de Reservas&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#666666;font-size:10.5px;&quot;&gt;Crear, cancelar y consultar reservas&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;&lt;b&gt;👥 Perfiles y Roles&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#666666;font-size:10.5px;&quot;&gt;Usuario, proveedor y administrador&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:4px;&quot;&gt;&lt;b&gt;🔔 Notificaciones&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#666666;font-size:10.5px;&quot;&gt;Estado de reserva, chat con el proveedor&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#2f4f9e;strokeWidth=2;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="280" height="470" as="geometry"/></mxCell><mxCell id="v7" value="&lt;div style=&quot;font-family:Helvetica;text-align:left;padding:4px;&quot;&gt;&lt;div style=&quot;font-weight:bold;color:#9c5700;font-size:14px;&quot;&gt;☁️ FIREBASE (Backend Cloud)&lt;/div&gt;&lt;div style=&quot;color:#888888;font-size:10px;margin:2px 0 8px 0;&quot;&gt;Servicios administrados de Google Cloud&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #cccccc;margin-bottom:10px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;&lt;b&gt;🗃️ Firestore&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#666666;font-size:10.5px;&quot;&gt;Reservas, parqueos, mensajería (tiempo real)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;&lt;b&gt;⚡ Cloud Functions&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#666666;font-size:10.5px;&quot;&gt;Validación de reservas y reportes&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;&lt;b&gt;🔔 Cloud Messaging (FCM)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#666666;font-size:10.5px;&quot;&gt;Envío de notificaciones push&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;&lt;b&gt;🔑 Authentication&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#666666;font-size:10.5px;&quot;&gt;Registro e inicio de sesión&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;background:#fdf3e7;border-radius:5px;padding:6px;text-align:center;margin-top:6px;&quot;&gt;&lt;b style=&quot;font-size:10.5px;&quot;&gt;Seguridad · Monitoreo (Crashlytics) · App Check&lt;/b&gt;&lt;br/&gt;&lt;i style=&quot;font-size:9.5px;color:#888888;&quot;&gt;(cross-cutting)&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#9c5700;strokeWidth=2;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="280" height="470" as="geometry"/></mxCell><mxCell id="v8" value="&lt;div style=&quot;font-family:Helvetica;text-align:left;padding:4px;&quot;&gt;&lt;div style=&quot;font-weight:bold;color:#2f6d2f;font-size:14px;&quot;&gt;📌 SERVICIOS EXTERNOS&lt;/div&gt;&lt;div style=&quot;color:#888888;font-size:10px;margin:2px 0 8px 0;&quot;&gt;Google Maps Platform&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #cccccc;margin-bottom:10px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;&lt;b&gt;📍 Google Maps API&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#666666;font-size:10.5px;&quot;&gt;Visualización de ubicación de parqueos&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;&lt;b&gt;📍 Places API&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#666666;font-size:10.5px;&quot;&gt;Búsqueda de estacionamientos cercanos&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:4px;&quot;&gt;&lt;b&gt;🗺️ Directions API&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#666666;font-size:10.5px;&quot;&gt;Cálculo de rutas y tiempo estimado&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#2f6d2f;strokeWidth=2;spacing=8;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="240" height="470" as="geometry"/></mxCell><mxCell id="v9" value="&lt;div style=&quot;font-family:Helvetica;text-align:left;padding:4px;&quot;&gt;&lt;div style=&quot;font-weight:bold;color:#172a54;font-size:13px;text-align:center;margin-bottom:8px;&quot;&gt;Funciones clave&lt;br/&gt;en la solución&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #cccccc;margin-bottom:10px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:9px;&quot;&gt;&lt;span style=&quot;display:inline-block;width:16px;height:16px;border-radius:50%;background:#2f4f9e;color:#ffffff;font-size:9px;text-align:center;line-height:16px;&quot;&gt;1&lt;/span&gt; &lt;span style=&quot;font-size:10.5px;&quot;&gt;Crear / actualizar reserva&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:9px;&quot;&gt;&lt;span style=&quot;display:inline-block;width:16px;height:16px;border-radius:50%;background:#9c5700;color:#ffffff;font-size:9px;text-align:center;line-height:16px;&quot;&gt;2&lt;/span&gt; &lt;span style=&quot;font-size:10.5px;&quot;&gt;Confirmación de reserva (listener)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:9px;&quot;&gt;&lt;span style=&quot;display:inline-block;width:16px;height:16px;border-radius:50%;background:#2f4f9e;color:#ffffff;font-size:9px;text-align:center;line-height:16px;&quot;&gt;3&lt;/span&gt; &lt;span style=&quot;font-size:10.5px;&quot;&gt;Consulta de ubicación (Maps)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:9px;&quot;&gt;&lt;span style=&quot;display:inline-block;width:16px;height:16px;border-radius:50%;background:#9c5700;color:#ffffff;font-size:9px;text-align:center;line-height:16px;&quot;&gt;4&lt;/span&gt; &lt;span style=&quot;font-size:10.5px;&quot;&gt;Resultado de búsqueda cercana&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:9px;&quot;&gt;&lt;span style=&quot;display:inline-block;width:16px;height:16px;border-radius:50%;background:#9c5700;color:#ffffff;font-size:9px;text-align:center;line-height:16px;&quot;&gt;5&lt;/span&gt; &lt;span style=&quot;font-size:10.5px;&quot;&gt;Notificación push (FCM)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:9px;&quot;&gt;&lt;span style=&quot;display:inline-block;width:16px;heig