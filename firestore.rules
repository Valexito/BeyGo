rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isParkingOwner(pid) {
      return signedIn()
        && get(/databases/$(db)/documents/parkings/$(pid)).data.ownerID == request.auth.uid;
    }

    function reservationOwnerUidFromData(reservation) {
      return
        reservation.ownerId is string && reservation.ownerId != ''
          ? reservation.ownerId
          : (
              reservation.ownerID is string && reservation.ownerID != ''
                ? reservation.ownerID
                : get(/databases/$(db)/documents/parkings/$(reservation.parkingId)).data.ownerID
            );
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isReservationOwner() {
      return signedIn() && reservationOwnerUidFromData(resource.data) == request.auth.uid;
    }

    function reservationParticipant(resId) {
      let reservation = get(/databases/$(db)/documents/reservations/$(resId)).data;
      return signedIn() && (
        reservation.userId == request.auth.uid ||
        reservationOwnerUidFromData(reservation) == request.auth.uid
      );
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'name',
          'phone',
          'photoURL',
          'role',
          'profileCompleted',
          'notificationSettings',
          'providerProfile',
          'providerStatus',
          'dob',
          'gender',
          'updatedAt',
          'createdAt'
        ]);

      allow update: if
        (
          isSelf(uid)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'uid',
            'email',
            'displayName',
            'name',
            'phone',
            'photoURL',
            'role',
            'profileCompleted',
            'notificationSettings',
            'providerProfile',
            'providerStatus',
            'dob',
            'gender',
            'updatedAt',
            'createdAt',
            'plateType',
            'vehiclePlate',
            'vehicleType',
            'fcmToken'        // ← FCM push notifications token
          ])
          && request.resource.data.uid == request.auth.uid
        )
        ||
        (
          isAdmin()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'providerStatus',
            'role',
            'updatedAt'
          ])
        );
    }

    match /support_reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'reportId',
          'reportNumber',
          'userId',
          'userEmail',
          'reportType',
          'subject',
          'message',
          'reservationId',
          'messageId',
          'reportedUid',
          'screenshotUrls',
          'screenshotCount',
          'createdAt'
        ])
        && request.resource.data.reportId is string
        && request.resource.data.reportNumber is string
        && request.resource.data.reportType is string
        && (
          !request.resource.data.keys().hasAny(['userEmail']) ||
          request.resource.data.userEmail == null ||
          request.resource.data.userEmail is string
        )
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && (
          !request.resource.data.keys().hasAny(['reservationId']) ||
          request.resource.data.reservationId is string
        )
        && (
          !request.resource.data.keys().hasAny(['messageId']) ||
          request.resource.data.messageId is string
        )
        && (
          !request.resource.data.keys().hasAny(['reportedUid']) ||
          request.resource.data.reportedUid is string
        )
        && (
          !request.resource.data.keys().hasAny(['screenshotUrls']) ||
          request.resource.data.screenshotUrls is list
        )
        && (
          !request.resource.data.keys().hasAny(['screenshotCount']) ||
          request.resource.data.screenshotCount is int
        );

      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /users/{uid}/{any=**} {
      allow read, create, update: if isSelf(uid) || isAdmin();
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /users/{uid} {
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /users/{uid}/reservation_control/{docId} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid)
        && docId == "main"
        && request.resource.data.keys().hasOnly([
          'userId',
          'cancelAttempts',
          'restrictedUntil',
          'updatedAt',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.cancelAttempts is int
        && (
          !request.resource.data.keys().hasAny(['restrictedUntil']) ||
          request.resource.data.restrictedUntil == null ||
          request.resource.data.restrictedUntil is timestamp
        );

      allow update: if
        (
          isSelf(uid)
          && docId == "main"
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'cancelAttempts',
            'restrictedUntil',
            'updatedAt'
          ])
          && (
            !request.resource.data.keys().hasAny(['cancelAttempts']) ||
            request.resource.data.cancelAttempts is int
          )
          && (
            !request.resource.data.keys().hasAny(['restrictedUntil']) ||
            request.resource.data.restrictedUntil == null ||
            request.resource.data.restrictedUntil is timestamp
          )
        )
        ||
        isAdmin();

      allow delete: if false;
    }

    match /users/{uid}/vehicles/{vehicleId} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'type',
          'plate',
          'isPrimary',
          'createdAt'
        ])
        && request.resource.data.type is string
        && request.resource.data.plate is string
        && request.resource.data.isPrimary is bool;

      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'type',
          'plate',
          'isPrimary',
          'updatedAt'
        ]);

      allow delete: if isSelf(uid) || isAdmin();
    }

    match /parkings/{parkingId} {
      allow read: if true;
      allow create: if
        (signedIn() && request.resource.data.ownerID == request.auth.uid)
        || isAdmin();

      allow update, delete: if isParkingOwner(parkingId) || isAdmin();

      // ── Star ratings submitted by users after completed reservations ──────
      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.reservationId is string
          && (
            request.resource.data.rating is int ||
            request.resource.data.rating is float
          )
          && (
            request.resource.data.parkingRating is int ||
            request.resource.data.parkingRating is float
          )
          && (
            request.resource.data.serviceRating is int ||
            request.resource.data.serviceRating is float
          )
          && (
            !request.resource.data.keys().hasAny(['comment']) ||
            request.resource.data.comment is string
          );
        allow delete: if false;
      }

      match /spaces/{spaceId} {
        allow read: if true;
        allow create, delete: if isParkingOwner(parkingId) || isAdmin();

        allow update: if
          isAdmin()
          ||
          // Owner: can set any status transition
          (
            isParkingOwner(parkingId) &&
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['status', 'currentReservationId', 'updatedAt'])
          )
          ||
          // User: free → requested (reserveSpaceProvider transaction)
          (
            signedIn() &&
            resource.data.status == "free" &&
            request.resource.data.status == "requested" &&
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['status', 'currentReservationId', 'updatedAt']) &&
            request.resource.data.currentReservationId is string
          )
          ||
          // User: free → occupied (legacy compat)
          (
            signedIn() &&
            resource.data.status == "free" &&
            request.resource.data.status == "occupied" &&
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['status', 'currentReservationId', 'updatedAt']) &&
            request.resource.data.currentReservationId is string
          )
          ||
          // User: occupied or requested → free (cancel/complete)
          (
            signedIn() &&
            (resource.data.status == "occupied" || resource.data.status == "requested") &&
            request.resource.data.status == "free" &&
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['status', 'currentReservationId', 'updatedAt'])
          );
      }

      match /walk_ins/{walkInId} {
        allow read: if isParkingOwner(parkingId) || isAdmin();

        allow create: if
          (isParkingOwner(parkingId) || isAdmin())
          && request.resource.data.keys().hasOnly([
            'spaceId',
            'spaceNumber',
            'reservationNumber',
            'customerName',
            'plate',
            'enteredAt',
            'pricePerHour',
            'status',
            'type',
            'createdAt'
          ])
          && request.resource.data.spaceId is string
          && request.resource.data.spaceNumber is int
          && request.resource.data.reservationNumber is string
          && request.resource.data.customerName is string
          && request.resource.data.plate is string
          && request.resource.data.enteredAt is timestamp
          && (
            !request.resource.data.keys().hasAny(['pricePerHour']) ||
            request.resource.data.pricePerHour == null ||
            request.resource.data.pricePerHour is int ||
            request.resource.data.pricePerHour is float
          )
          && request.resource.data.status == "active"
          && request.resource.data.type == "walk_in";

        allow update: if
          (isParkingOwner(parkingId) || isAdmin())
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'status',
            'exitAt',
            'durationMinutes',
            'amount',
            'updatedAt'
          ])
          && (
            !request.resource.data.keys().hasAny(['status']) ||
            request.resource.data.status in ["active", "completed", "cancelled"]
          )
          && (
            !request.resource.data.keys().hasAny(['exitAt']) ||
            request.resource.data.exitAt == null ||
            request.resource.data.exitAt is timestamp
          )
          && (
            !request.resource.data.keys().hasAny(['durationMinutes']) ||
            request.resource.data.durationMinutes is int
          )
          && (
            !request.resource.data.keys().hasAny(['amount']) ||
            request.resource.data.amount is int ||
            request.resource.data.amount is float
          );

        allow delete: if false;
      }
    }

    match /reservations/{resId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.parkingId is string
        && request.resource.data.parkingName is string
        && request.resource.data.ownerId is string
        && request.resource.data.spaceNumber is int
        && request.resource.data.state == "pending"
        && request.resource.data.providerApprovalStatus == "pending"
        && request.resource.data.reservedAt is timestamp
        && (
          !request.resource.data.keys().hasAny(['exitStatus']) ||
          request.resource.data.exitStatus == "none"
        );

      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isReservationOwner() ||
        isAdmin()
      );

      allow update: if signedIn() && (

        // USER
        (
          resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'state',
            'cancelRequestedAt',
            'cancellationReason',
            'cancelledBy',
            'cancellationPenaltyApplied',
            'providerApprovalStatus',
            'cancelAttempts',
            'userCancelAttempts',
            'restrictedUntil',
            'exitStatus',
            'exitRequestedAt',
            'exitRequestedBy',
            'exitLockedAt',
            'estimatedAmount',
            'estimatedDurationMinutes',
            'endedAt',
            'ratingPromptHandled',
            'ratingSubmitted',
            'ratingSubmittedAt',
            'ratingSkippedAt'
          ])
        )

        ||

        // OWNER
        (
          isReservationOwner()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'state',
            'providerApprovalStatus',
            'reservationNumber',
            'ownerId',
            'endedAt',
            'exitStatus',
            'exitApprovedAt',
            'exitApprovedBy',
            'exitLockedAt',
            'amount',
            'durationMinutes',
            'pricePerHour',
            'cancellationReason',
            'cancelledBy',
            'cancellationPenaltyApplied',
            'estimatedAmount',
            'estimatedDurationMinutes'
          ])
        )

        ||

        isAdmin()
      );

      allow delete: if signedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      match /messages/{messageId} {
        allow read: if reservationParticipant(resId) || isAdmin();

        allow create: if
          (reservationParticipant(resId) || isAdmin())
          && request.resource.data.keys().hasOnly([
            'reservationId',
            'senderId',
            'senderRole',
            'text',
            'createdAt'
          ])
          && request.resource.data.reservationId == resId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole in ['user', 'owner']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt is timestamp
          && get(/databases/$(db)/documents/reservations/$(resId)).data.state in [
            'pending',
            'active',
            'cancellation_requested'
          ]
          && !exists(/databases/$(db)/documents/reservations/$(resId)/chat_blocks/$(request.auth.uid))
          && (
            (request.resource.data.senderRole == 'user' &&
              get(/databases/$(db)/documents/reservations/$(resId)).data.userId == request.auth.uid &&
              (
                !exists(/databases/$(db)/documents/reservations/$(resId)/chat_blocks/$(reservationOwnerUidFromData(get(/databases/$(db)/documents/reservations/$(resId)).data)))
                ||
                get(/databases/$(db)/documents/reservations/$(resId)/chat_blocks/$(reservationOwnerUidFromData(get(/databases/$(db)/documents/reservations/$(resId)).data))).data.blockedUid != request.auth.uid
              ))
            ||
            (request.resource.data.senderRole == 'owner' &&
              reservationOwnerUidFromData(get(/databases/$(db)/documents/reservations/$(resId)).data) == request.auth.uid &&
              (
                !exists(/databases/$(db)/documents/reservations/$(resId)/chat_blocks/$(get(/databases/$(db)/documents/reservations/$(resId)).data.userId))
                ||
                get(/databases/$(db)/documents/reservations/$(resId)/chat_blocks/$(get(/databases/$(db)/documents/reservations/$(resId)).data.userId)).data.blockedUid != request.auth.uid
              ))
          );

        allow update: if false;
        allow delete: if isAdmin();
      }

      match /chat_blocks/{blockerUid} {
        allow read: if reservationParticipant(resId) || isAdmin();

        allow create: if signedIn()
          && blockerUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'reservationId',
            'blockerUid',
            'blockedUid',
            'createdAt'
          ])
          && request.resource.data.reservationId == resId
          && request.resource.data.blockerUid == request.auth.uid
          && request.resource.data.blockedUid is string
          && request.resource.data.createdAt is timestamp
          && (
            (
              get(/databases/$(db)/documents/reservations/$(resId)).data.userId == request.auth.uid
              && request.resource.data.blockedUid == reservationOwnerUidFromData(get(/databases/$(db)/documents/reservations/$(resId)).data)
            )
            ||
            (
              reservationOwnerUidFromData(get(/databases/$(db)/documents/reservations/$(resId)).data) == request.auth.uid
              && request.resource.data.blockedUid == get(/databases/$(db)/documents/reservations/$(resId)).data.userId
            )
          );

        allow delete: if signedIn() && blockerUid == request.auth.uid || isAdmin();
        allow update: if false;
      }
    }

    match /favorites/{favId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null;
    }

    match /account_deletion_requests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
          'email',
          'fullName',
          'phone',
          'reason',
          'details',
          'confirm',
          'status',
          'source',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 1
        && (
          !request.resource.data.keys().hasAny(['phone']) ||
          request.resource.data.phone is string
        )
        && (
          !request.resource.data.keys().hasAny(['reason']) ||
          request.resource.data.reason is string
        )
        && (
          !request.resource.data.keys().hasAny(['details']) ||
          request.resource.data.details is string
        )
        && request.resource.data.confirm == true
        && request.resource.data.status == 'pending'
        && request.resource.data.source == 'web'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow read, update: if isAdmin();
      allow delete: if false;
    }

    match /provider_applications/{appId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /provider_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

  }
}
